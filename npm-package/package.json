{
  "name": "@polylint/adrlint",
  "version": "0.5.1",
  "description": "A fast, opinionated linter and formatter for MADR architecture decision records",
  "bin": {
    "adrlint": "bin/adrlint"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "keywords": [
    "adr",
    "architecture-decision-record",
    "madr",
    "linter",
    "markdown",
    "cli",
    "rust",
    "documentation"
  ],
  "author": "Na'aman Hirschfeld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polylint/adrlint.git"
  },
  "homepage": "https://github.com/polylint/adrlint#readme",
  "bugs": {
    "url": "https://github.com/polylint/adrlint/issues"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "tar": "^7.5.23"
  },
  "optionalDependencies": {
    "@polylint/adrlint-darwin-arm64": "0.5.1",
    "@polylint/adrlint-darwin-x64": "0.5.1",
    "@polylint/adrlint-linux-arm64-gnu": "0.5.1",
    "@polylint/adrlint-linux-arm64-musl": "0.5.1",
    "@polylint/adrlint-linux-x64-gnu": "0.5.1",
    "@polylint/adrlint-linux-x64-musl": "0.5.1",
    "@polylint/adrlint-win32-arm64": "0.5.1",
    "@polylint/adrlint-win32-x64": "0.5.1"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "install.js",
    "bin/adrlint"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
